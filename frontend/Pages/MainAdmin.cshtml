@page
@model SistemaPrecos.Web.Pages.MainAdminModel
@{
    ViewData["Title"] = "Painel Administrador";
}
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var adminId = HttpContextAccessor.HttpContext?.Request.Cookies["userId"];
}

<style>
    /* =============================================
       ESTILOS GERAIS
       ============================================= */
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f1f1f1;
        height: 100vh;
        overflow: visible; /* para que o modal possa aparecer inteiro */
        display: flex;     /* para manter a sidebar fixa à esquerda */
    }

    /* =============================================
       SIDEBAR
       ============================================= */
    .sidebar {
        width: 260px;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1rem;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    .sidebar.closed {
        transform: translateX(-100%);
    }

    .sidebar-top {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-top: 1rem;
    }

    .sidebar-top img {
        width: 150px;
        height: auto;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        align-items: center;
    }

    .menu a {
        display: block;
        background-color: #2c2c2c;
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 0.8rem 2rem;
        border-radius: 10px;
        text-align: center;
        width: 80%;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .menu a:hover {
        background-color: #111;
        transform: scale(1.05);
    }

    .user-profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        padding: 1rem 0;
    }

    .user-icon {
        background-color: #2c2c2c;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        font-size: 24px;
        z-index: 1001;
    }

    .user-info-sidebar {
        margin-top: 0.5rem;
        font-weight: bold;
        font-size: 1rem;
        color: #2c2c2c;
        text-align: center;
    }

    .user-role {
        font-size: 0.85rem;
        color: gray;
    }

    /* =============================================
       ÁREA PRINCIPAL
       ============================================= */
    .main-container {
        margin-left: 260px;
        width: calc(100% - 260px);
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        overflow: auto;
        transition: margin-left 0.3s ease, width 0.3s ease;
    }

    .main-container.full-width {
        margin-left: 0;
        width: 100%;
    }

    .container {
        background-color: #fff;
        padding: 2rem 3rem;
        border-radius: 12px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        max-width: 800px;
        width: 100%;
        text-align: center;
    }

    h2 {
        font-size: 2.4rem;
        margin-bottom: 1rem;
        color: #2c2c2c;
    }

    .user-info {
        margin-top: 1rem;
        font-size: 1.2rem;
        font-weight: bold;
        color: #333;
    }

    .toggle-btn {
        position: fixed;
        top: 1rem;
        left: 1rem;
        background-color: #2c2c2c;
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        z-index: 1100;
        transition: background 0.3s ease;
    }

    .toggle-btn:hover {
        background-color: #111;
    }

    /* =============================================
       BOTÃO FLOUTANTE PARA ABRIR O MODAL DE MENSAGEM
       ============================================= */
    .mensagem-fab {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px;
        height: 60px;
        background-color: #333;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.2);
        cursor: pointer;
        z-index: 1000;
        transition: background-color 0.3s;
    }

    .mensagem-fab:hover {
        background-color: #111;
    }

    .mensagem-fab svg {
        width: 24px;
        height: 24px;
        fill: white;
    }

    /* =============================================
       O “MODAL” DE ENVIO DE MENSAGEM
       (mantivemos exatamente o mesmo que você já tinha)
       ============================================= */
    .mensagem-modal {
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 300px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        padding: 1rem;
        display: none;       /* começa oculto */
        flex-direction: column;
        gap: 0.5rem;
        z-index: 1001;
    }

    .mensagem-modal textarea {
        width: 100%;
        height: 100px;
        resize: none;
        border-radius: 8px;
        padding: 0.5rem;
        border: 1px solid #ccc;
    }

    .mensagem-modal button {
        align-self: flex-end;
        background-color: #333;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .mensagem-modal button:hover {
        background-color: #111;
    }
</style>

<!-- ========== BOTÃO PARA RECOLHER/EXPANDIR A SIDEBAR ========== -->
<button class="toggle-btn" onclick="toggleSidebar()">☰</button>

<!-- =============================================
     SIDEBAR (com link “Ver Utilizadores” adicionado)
     ============================================= -->
<div class="sidebar" id="sidebar">
    <div class="sidebar-top">
        <img src="/img/CP.png" alt="Compare Price" />
        <div class="menu">
            <!-- Links já existentes -->
            <a href="/Produtos/ListaAdmin">Listar Produtos</a>
            <a href="/Lojas/ListaLojas">Listar Lojas</a>
            <a href="/Categorias/ListaCategorias">Listar Categorias</a>
            <a asp-page="/Relatorios/EscolherRelatorio">Imprimir PDFs</a>
            <a href="/VerUtilizadores">Ver Utilizadores</a>
        </div>
    </div>

    <!-- AVATAR + NOME (clicável para abrir menu de perfil) -->
    <div class="user-profile" id="profileToggle">
        <div class="user-icon">👤</div>
        <div class="user-info-sidebar">
            @Model.NomeUtilizador
            <div class="user-role">Administrador</div>
        </div>
    </div>
</div>

<!-- =============================================
     ÁREA PRINCIPAL (conteúdo central)
     ============================================= -->
<div class="main-container" id="main">
    <div class="container">
        <h2>Painel de Administração</h2>
        <div class="user-info">Olá, @Model.NomeUtilizador</div>
    </div>
</div>

<!-- =============================================
     BOTÃO FLOUTANTE PARA ABRIR O MODAL DE MENSAGEM
     ============================================= -->
<div class="mensagem-fab" onclick="toggleMensagemModal()">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M2 2v20l4-4h16V2H2zm16 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/>
    </svg>
</div>

<!-- =============================================
     “Modal” de Envio de Mensagem (exatamente igual ao original)
     ============================================= -->
<div id="mensagemModal" class="mensagem-modal">
    <textarea id="mensagemTexto" placeholder="Escreve a mensagem..."></textarea>
    <button onclick="enviarMensagem()">Enviar</button>
</div>

<!-- =============================================
     MODAL DE PERFIL (AVATAR) — opcional, se quiser manter
     ============================================= -->
<div id="profileModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.5); justify-content:center; align-items:center; z-index:2000;">
    <div class="modal-content" style="background-color:#fff; border-radius:12px; padding:1.5rem 1.5rem 2rem; width:320px; max-width:90%; box-shadow:0 8px 20px rgba(0,0,0,0.2); text-align:center; position:relative;">
        <button class="modal-close" id="modalCloseBtn" style="position:absolute; top:16px; right:16px; background:transparent; border:none; font-size:1.5rem; cursor:pointer; color:#555;">&times;</button>
        <h3 style="margin:0; font-size:1.4rem; color:#2c2c2c; margin-bottom:1.5rem;">Opções de Perfil</h3>
        <a asp-page="/Conta/Perfil" style="display:block; width:100%; padding:0.6rem 0; margin-bottom:0.8rem; text-decoration:none; color:#fff; background-color:#2c2c2c; border:none; border-radius:6px; font-size:1rem; font-weight:bold; cursor:pointer; transition:background-color 0.2s ease, transform 0.1s ease;">Editar Perfil</a>
        <a asp-page="/Conta/CancelarConta" style="display:block; width:100%; padding:0.6rem 0; margin-bottom:0.8rem; text-decoration:none; color:#fff; background-color:#2c2c2c; border:none; border-radius:6px; font-size:1rem; font-weight:bold; cursor:pointer; transition:background-color 0.2s ease, transform 0.1s ease;">Cancelar Conta</a>
        <a href="/Login" style="display:block; width:100%; padding:0.6rem 0; margin-bottom:0.8rem; text-decoration:none; color:#fff; background-color:#2c2c2c; border:none; border-radius:6px; font-size:1rem; font-weight:bold; cursor:pointer; transition:background-color 0.2s ease, transform 0.1s ease;">Terminar Sessão</a>
    </div>
</div>

<script>
    /* ========== FUNÇÃO PARA RECOLHER/EXPANDIR A SIDEBAR ========== */
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const main = document.getElementById('main');
        sidebar.classList.toggle('closed');
        main.classList.toggle('full-width');
    }

    /* ========== FUNÇÃO PARA ABRIR/FECHAR O MODAL DE MENSAGEM ========== */
    function toggleMensagemModal() {
        const modal = document.getElementById('mensagemModal');
        // Alterna entre display:flex (mostrar) e display:none (esconder)
        modal.style.display = (modal.style.display === 'flex') ? 'none' : 'flex';
    }

    /* ========== FUNÇÃO PARA ENVIAR MENSAGEM PARA A API ========== */
    async function enviarMensagem() {
        const texto = document.querySelector('#mensagemModal textarea').value;
        if (texto.trim() === '') {
            alert('Escreve uma mensagem primeiro!');
            return;
        }

        const mensagem = {
            conteudo: texto,
            idUtilizador: parseInt('@adminId')
        };

        try {
            const response = await fetch('http://localhost:5000/api/mensagem/enviar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(mensagem)
            });

            if (!response.ok) {
                throw new Error('Erro ao enviar mensagem');
            }

            alert('Mensagem enviada!');
            document.querySelector('#mensagemModal textarea').value = '';
            document.getElementById('mensagemModal').style.display = 'none';
        } catch (error) {
            alert('Erro ao enviar: ' + error.message);
        }
    }

    /* ========== LÓGICA DO MODAL DE PERFIL (AVATAR) ========== */
    document.addEventListener("DOMContentLoaded", function() {
        var profileToggle = document.getElementById("profileToggle");
        var profileModal = document.getElementById("profileModal");
        var modalCloseBtn = document.getElementById("modalCloseBtn");

        // Ao clicar no avatar, abre o modal
        profileToggle.addEventListener("click", function(event) {
            event.stopPropagation();
            profileModal.style.display = "flex";
        });

        // Ao clicar no botão “×”, fecha o modal
        modalCloseBtn.addEventListener("click", function() {
            profileModal.style.display = "none";
        });

        // Ao clicar no overlay fora da caixa, fecha o modal
        profileModal.addEventListener("click", function(event) {
            if (event.target === profileModal) {
                profileModal.style.display = "none";
            }
        });
    });
</script>
