@page "/Main"
@model SistemaPrecos.Web.Pages.MainModel

@{
    ViewData["Title"] = "Compare Price";
}

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f1f1f1;
        height: 100vh;
        overflow-x: hidden;
        display: flex;
    }

    .sidebar {
        width: 260px;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1rem;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    .sidebar.closed {
        transform: translateX(-100%);
    }

    .sidebar-top {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-top: 1rem;
    }

    .sidebar-top img {
        width: 150px;
        height: auto;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        align-items: center;
    }

    .menu a {
        display: block;
        background-color: #2c2c2c;
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 0.8rem 2rem;
        border-radius: 10px;
        text-align: center;
        width: 80%;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .menu a:hover {
        background-color: #111;
        transform: scale(1.05);
    }

    .logout {
        margin-bottom: 2rem;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .logout form {
        width: 80%;
    }

    .logout button {
        width: 100%;
        display: block;
        background-color: #2c2c2c;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        padding: 0.8rem 2rem;
        border: none;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .logout button:hover {
        background-color: #111;
        transform: scale(1.05);
    }

    .main-container {
        margin-left: 260px;
        width: calc(100% - 260px);
        height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 2rem;
        transition: margin-left 0.3s ease, width 0.3s ease;
    }

    .main-container.full-width {
        margin-left: 0;
        width: 100%;
    }

    .main-container h1 {
        font-size: 2.5rem;
        margin-bottom: 0rem;
    }

    .main-container p {
        font-size: 1.2rem;
        color: #555;
        margin-top: 0rem;
        margin-bottom: 2rem;
    }

    .buttons {
        display: flex;
        gap: 2rem;
    }

    .buttons a {
        background-color: #2c2c2c;
        color: white;
        text-decoration: none;
        padding: 1rem 2.5rem;
        font-weight: bold;
        border-radius: 10px;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .buttons a:hover {
        background-color: #111;
        transform: scale(1.05);
    }

    .toggle-btn {
        position: fixed;
        top: 1rem;
        left: 1rem;
        background-color: #2c2c2c;
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        z-index: 1100;
        transition: background 0.3s ease;
    }

    .toggle-btn:hover {
        background-color: #111;
    }
</style>

<!-- Botão de abrir/fechar sidebar -->
<button class="toggle-btn" onclick="toggleSidebar()">☰</button>

<div class="sidebar" id="sidebar">
    <div class="sidebar-top">
        <img src="/img/CP.png" alt="Compare Price" />

        <div class="menu">
            <a href="/Produtos/Lista">Listar Produtos</a>
            <a href="/Produtos/Comparar">Comparar Preços</a>
        </div>
    </div>

    <div class="logout">
        @if (Model.EstaAutenticado)
        {
            <form method="post" asp-page-handler="Logout">
                <button type="submit">Terminar Sessão</button>
            </form>
        }
        else
        {
            <form method="get" action="/Login">
                <button type="submit">Entrar</button>
            </form>
        }
    </div>
</div>

<div class="main-container" id="main">
    <h1>Bem-vindo à plataforma <strong>Compare Price</strong></h1>
    <p>Explore e compare os melhores preços disponíveis.</p>

</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const main = document.getElementById('main');

        sidebar.classList.toggle('closed');
        main.classList.toggle('full-width');
    }
</script>
