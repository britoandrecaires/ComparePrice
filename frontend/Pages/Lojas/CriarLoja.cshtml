@page
@model CriarLojaModel
@{
    ViewData["Title"] = "Registar Loja";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f2f2f2;
        margin: 0;
        color: #2c2c2c;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 2rem;
        background-color: #ffffff;
        border-bottom: 1px solid #ddd;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .logo { height: 80px; }

    .topbar a {
        color: #333;
        text-decoration: none;
        font-weight: bold;
        margin-left: 1rem;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        transition: background 0.2s ease;
    }

    .topbar a:hover { background-color: #e2e2e2; }

    .form-container {
        max-width: 600px;
        margin: 3rem auto;
        padding: 2.5rem;
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
    }

    h2 {
        text-align: center;
        margin-bottom: 2rem;
        font-size: 1.8rem;
        color: #333;
    }

    label {
        display: block;
        margin-top: 1rem;
        font-weight: bold;
    }

    input, select {
        width: 100%;
        padding: 0.75rem;
        margin-top: 0.4rem;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .btn-submit, .btn-voltar {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 0.75rem 1.5rem;
        border: none;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        font-size: 1rem;
    }

    .btn-submit {
        background-color: #333;
        color: white;
        width: 100%;
        transition: background 0.3s ease;
    }

    .btn-submit:hover { background-color: #111; }

    .btn-voltar {
        background-color: #999;
        color: white;
        margin-top: 1rem;
    }

    .btn-voltar:hover { background-color: #777; }

    .text-danger {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.2rem;
        display: block;
    }

    .erro {
        color: red;
        margin-bottom: 1rem;
        font-weight: bold;
        text-align: center;
    }
</style>

<div class="topbar">
    <img src="/img/CP.png" alt="Compare Price" class="logo" />
    <a asp-page="/Login">Terminar Sessão</a>
</div>

<div class="form-container">
    <a href="javascript:window.history.back()" class="btn-voltar">Voltar</a>

    <h2>Registar Loja</h2>

    @if (!string.IsNullOrEmpty(Model.Erro))
    {
        <div class="erro">@Model.Erro</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()

        <label>Nome da Loja:</label>
        <input asp-for="Loja.Nome" placeholder="Ex: Supermercado Centro" />
        <span asp-validation-for="Loja.Nome" class="text-danger"></span>

        <label>Cidade:</label>
        <input asp-for="Loja.Localizacao.Cidade" placeholder="Lisboa" />
        <span asp-validation-for="Loja.Localizacao.Cidade" class="text-danger"></span>

        <label>País:</label>
        <input asp-for="Loja.Localizacao.Pais" placeholder="Portugal" />
        <span asp-validation-for="Loja.Localizacao.Pais" class="text-danger"></span>

        <label>Código-Postal:</label>
        <input asp-for="Loja.Localizacao.CodigoPostal" placeholder="1000-000" />
        <span asp-validation-for="Loja.Localizacao.CodigoPostal" class="text-danger"></span>

        <button type="submit" class="btn-submit">Criar</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
