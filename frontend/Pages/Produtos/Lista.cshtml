@page "/Produtos/Lista"
@model SistemaPrecos.Web.Pages.Produtos.ListaModel
@{
    ViewData["Title"] = "Lista de Produtos";
}

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f1f1f1;
        height: 100vh;
        overflow-x: hidden;
        display: flex;
    }

    .sidebar {
        width: 260px;
        background-color: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1rem;
        box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        transition: transform 0.3s ease;
        z-index: 1000;
    }

    .sidebar.closed {
        transform: translateX(-100%);
    }

    .sidebar-top {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-top: 1rem;
    }

    .sidebar-top img {
        width: 150px;
        height: auto;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 100%;
        align-items: center;
    }

    .menu a {
        display: block;
        background-color: #2c2c2c;
        color: white;
        text-decoration: none;
        font-weight: bold;
        padding: 0.8rem 2rem;
        border-radius: 10px;
        text-align: center;
        width: 80%;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .menu a:hover {
        background-color: #111;
        transform: scale(1.05);
    }

    .logout {
        margin-bottom: 2rem;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .logout form {
        width: 80%;
    }

    .menu-button {
        width: 100%;
        background-color: #2c2c2c;
        color: white;
        font-weight: bold;
        font-size: 1.1rem;
        padding: 0.8rem 2rem;
        border: none;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
    }

    .menu-button:hover {
        background-color: #111;
        transform: scale(1.05);
    }

    .main-container {
        margin-left: 260px;
        width: calc(100% - 260px);
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 2rem;
    }

    .main-container.full-width {
        margin-left: 0;
        width: 100%;
    }

    .container {
        background-color: #fff;
        padding: 3rem 4rem;
        border-radius: 12px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        max-width: 1100px;
        width: 100%;
    }

    h2 {
        font-size: 2.4rem;
        margin-bottom: 2rem;
    }

    form {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    input[type="text"],
    select {
        padding: 0.8rem;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 1.1rem;
        min-width: 250px;
    }

    button[type="submit"] {
        padding: 0.8rem 1.5rem;
        background-color: #2c2c2c;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    button[type="submit"]:hover {
        background-color: #111;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2rem;
    }

    th, td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid #e0e0e0;
    }

    th {
        background-color: #444;
        color: white;
    }

    tr:hover {
        background-color: #f5f5f5;
    }

    .empty {
        text-align: center;
        color: #888;
        padding: 2rem;
        font-style: italic;
    }

    .btn-primary {
        padding: 0.5rem 1rem;
        background-color: #2c2c2c;
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
        transition: background 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #111;
    }

    .toggle-btn {
        position: fixed;
        top: 1rem;
        left: 1rem;
        background-color: #2c2c2c;
        color: white;
        border: none;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 8px;
        cursor: pointer;
        z-index: 1100;
        transition: background 0.3s ease;
    }

    .toggle-btn:hover {
        background-color: #111;
    }
</style>

<button class="toggle-btn" onclick="toggleSidebar()">☰</button>

<div class="sidebar" id="sidebar">
    <div class="sidebar-top">
        <img src="/img/CP.png" alt="Compare Price" />
        <div class="menu">
            <a href="/Produtos/Lista">Listar Produtos</a>
            <a href="/Produtos/Comparar">Comparar Preços</a>
        </div>
    </div>
    <div class="logout">
        <form method="get" action="/Main">
            <button type="submit" class="menu-button">Voltar</button>
        </form>
    </div>
</div>

<div class="main-container" id="main">
    <div class="container">
        <h2>Lista de Produtos</h2>

        <form method="get">
            <input type="text" name="termoPesquisa" placeholder="Procurar por nome..." value="@Model.TermoPesquisa" />
            <select name="categoriaId">
                <option value="">Todas as Categorias</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.CategoriaId" selected="@(categoria.CategoriaId == Model.CategoriaId)">@categoria.Nome</option>
                }
            </select>
            <button type="submit">Pesquisar</button>
        </form>

        @if (Model.Produtos.Count == 0)
        {
            <div class="empty">Nenhum produto encontrado.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Marca</th>
                        <th>Descrição</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var produto in Model.Produtos)
                    {
                        <tr>
                            <td>@produto.Nome</td>
                            <td>@produto.Marca</td>
                            <td>@produto.Descricao</td>
                            <td>
                                <a href="/Produtos/Detalhes/@produto.ProdutoId" class="btn-primary">Ver Detalhes</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const main = document.getElementById('main');
        sidebar.classList.toggle('closed');
        main.classList.toggle('full-width');
    }
</script>
